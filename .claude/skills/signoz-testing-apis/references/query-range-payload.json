{
  "schemaVersion": "v1",
  "start": 1757300000000,
  "end": 1757303600000,
  "requestType": "time_series",
  "compositeQuery": {
    "queries": [
      {
        "type": "builder_query",
        "spec": {
          "name": "A",
          "signal": "traces",
          "stepInterval": "60s",
          "disabled": false,
          "aggregations": [
            { "expression": "count()", "alias": "span_count" },
            { "expression": "avg(duration_nano)", "alias": "avg_duration" }
          ],
          "filter": { "expression": "service.name = 'frontend' AND http.status_code >= 500" },
          "groupBy": [
            { "name": "service.name", "fieldContext": "resource" },
            { "name": "http.status_code", "fieldContext": "span", "fieldDataType": "int64" }
          ],
          "selectFields": [
            { "name": "service.name", "fieldContext": "resource" },
            { "name": "http.route", "fieldContext": "span", "fieldDataType": "string" }
          ],
          "order": [
            { "key": { "name": "span_count" }, "direction": "desc" }
          ],
          "having": { "expression": "span_count > 10" },
          "limit": 10,
          "legend": "{{service.name}}"
        }
      }
    ]
  }
}
