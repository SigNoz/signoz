#!/bin/sh

set -e

msg_file="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

if [ -d frontend/node_modules ] && command -v pnpm >/dev/null 2>&1; then
	(cd frontend && pnpm exec commitlint --edit "$msg_file")
else
	# Header-only fallback for @commitlint/config-conventional when node_modules is absent.
	header="$(grep -v '^#' "$msg_file" | grep -m1 -v '^[[:space:]]*$' || true)"
	case "$header" in
	Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) ;;
	*)
		if ! printf '%s\n' "$header" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: [^ ].*$' ||
			[ "${#header}" -gt 100 ]; then
			echo "commit-msg: header must be '<type>(<scope>): <subject>', at most 100 chars" >&2
			exit 1
		fi
		;;
	esac
fi

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ -n "$TERM" ] && [ "$TERM" != "dumb" ]; then
  color_red="$(tput setaf 1)"
  bold="$(tput bold)"
  reset="$(tput sgr0)"
else
  color_red=""
  bold=""
  reset=""
fi

if [ "$branch" = "main" ]; then
  echo "${color_red}${bold}You can't commit directly to the main branch${reset}"
  exit 1
fi
