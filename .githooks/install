#!/bin/sh
# Idempotent; run by make and the frontend postinstall.

set -e

git rev-parse --git-dir >/dev/null 2>&1 || exit 0

git config --local --unset-all core.hooksPath 2>/dev/null || true

# A global/system core.hooksPath would receive the stubs and shadow .git/hooks.
if global_path="$(git config --get core.hooksPath)"; then
	echo "githooks: core.hooksPath=$global_path is set outside this repo; hooks not installed" >&2
	exit 0
fi

hooks_dir="$(git rev-parse --git-path hooks)"
mkdir -p "$hooks_dir"

for hook in pre-commit commit-msg; do
	cat >"$hooks_dir/$hook" <<EOF
#!/bin/sh
# Generated by .githooks/install.
root="\$(git rev-parse --show-toplevel)"
[ -x "\$root/.githooks/$hook" ] || exit 0
exec "\$root/.githooks/$hook" "\$@"
EOF
	chmod +x "$hooks_dir/$hook"
done
