{
  "compilerOptions": {
    "target": "ES2020",
    // `moduleResolution: bundler` requires `module` at es2015+ — the previous
    // `commonjs` pairing made `pnpm typecheck` bail on TS5095 before checking a
    // single file. Playwright transpiles with its own loader and this config is
    // only ever used with `--noEmit`, so the emit format is immaterial.
    "module": "esnext",
    "moduleResolution": "bundler",
    // `dom` is needed because helpers run browser code inside `page.evaluate`
    // callbacks (localStorage, window, document).
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "paths": {
      "@tests/*": ["./tests/*"],
      "@helpers/*": ["./helpers/*"],
      "@specs/*": ["./specs/*"]
    },
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["tests/**/*.ts", "helpers/**/*.ts", "fixtures/**/*.ts", "bootstrap/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
