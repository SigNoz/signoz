{
  "version": 1,
  "definition": {
    "schemaVersion": "v6",
    "name": "signoz---cost-meter-breakdown",
    "tags": [],
    "spec": {
      "display": {
        "name": "Cost Meter Breakdown",
        "description": "Logs, spans and metric datapoints ingested, from the signoz.meter.* metrics. Aggregated hourly; billing is calculated in UTC."
      },
      "variables": [],
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "Total"
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 4,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/f320363c-f077-5a13-ab53-cbf5c50c58c9"
                }
              },
              {
                "x": 4,
                "y": 0,
                "width": 4,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/28703c9e-3405-52b8-96bb-c390a2aa07bf"
                }
              },
              {
                "x": 8,
                "y": 0,
                "width": 4,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/59ea13f9-5e13-54f8-843f-128dcf160c99"
                }
              }
            ]
          }
        },
        {
          "kind": "Grid",
          "spec": {
