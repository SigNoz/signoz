        },
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "Metrics"
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/686fb25a-5b45-5956-9b37-45cb8ff90f78"
                }
              }
            ]
          }
        }
      ],
      "panels": {
        "f320363c-f077-5a13-ab53-cbf5c50c58c9": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Total size of log records ingested"
            },
            "plugin": {
              "kind": "signoz/NumberPanel",
              "spec": {
                "visualization": {
                  "timePreference": "global_time"
                },
                "formatting": {
                  "unit": "bytes"
                }
              }
            },
            "queries": [
              {
                "kind": "scalar",
                "spec": {
                  "plugin": {
                    "kind": "signoz/BuilderQuery",
                    "spec": {
                      "name": "A",
                      "signal": "metrics",
                      "source": "meter",
                      "disabled": false,
                      "aggregations": [
                        {
                          "metricName": "signoz.meter.log.size",
                          "timeAggregation": "increase",
                          "spaceAggregation": "sum",
                          "reduceTo": "sum"
                        }
                      ],
                      "legend": "count"
                    }
                  }
                }
              }
            ]
          }
        },
        "28703c9e-3405-52b8-96bb-c390a2aa07bf": {
