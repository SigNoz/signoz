{
  "version": 1,
  "definition": {
    "schemaVersion": "v6",
    "name": "signoz---celery-tasks",
    "tags": [],
    "spec": {
      "display": {
        "name": "Celery",
        "description": "Celery task throughput, states, latency and errors from task spans, with worker activity from Flower."
      },
      "variables": [
        {
          "kind": "ListVariable",
          "spec": {
            "name": "task_name",
            "display": {
              "name": "Task",
              "description": "Celery task name"
            },
            "allowMultiple": true,
            "allowAllValue": true,
            "sort": "alphabetical-asc",
            "plugin": {
              "kind": "signoz/DynamicVariable",
              "spec": {
                "name": "celery.task_name",
                "signal": "traces"
              }
            }
          }
        }
      ],
      "panels": {
