{
  "version": 1,
  "definition": {
    "schemaVersion": "v6",
    "name": "signoz---services-external-calls",
    "tags": [],
    "spec": {
      "display": {
        "name": "Service External Calls",
        "description": "Calls the service makes to other addresses, from span metrics."
      },
      "variables": [
        {
          "kind": "ListVariable",
          "spec": {
            "name": "service_name",
            "display": {
              "name": "service_name",
              "description": "Service"
            },
            "allowMultiple": false,
            "allowAllValue": false,
            "sort": "alphabetical-asc",
            "plugin": {
              "kind": "signoz/DynamicVariable",
              "spec": {
                "name": "service.name",
                "signal": "traces"
              }
            }
          }
        },
        {
          "kind": "ListVariable",
          "spec": {
            "name": "environment",
            "display": {
              "name": "environment",
              "description": "Deployment environment"
            },
            "allowMultiple": true,
            "allowAllValue": true,
            "sort": "alphabetical-asc",
            "plugin": {
              "kind": "signoz/DynamicVariable",
              "spec": {
                "name": "deployment.environment",
                "signal": "traces"
              }
            }
          }
        }
      ],
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/f57b9935-e3b9-5e88-a789-c17e5f67f8b0"
                }
              },
              {
                "x": 6,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/bf19297f-469d-5c7f-87cd-142e51aee195"
                }
              },
              {
                "x": 0,
                "y": 6,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/6341ce52-d7d7-58a8-9e33-27a3f46bc125"
                }
              },
              {
                "x": 6,
                "y": 6,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/ad2de3fd-cd9f-5406-8e48-6d3811a31c14"
                }
              }
            ]
          }
        }
      ],
      "panels": {
        "f57b9935-e3b9-5e88-a789-c17e5f67f8b0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "External Call Error Percentage"
            },
            "plugin": {
              "kind": "signoz/TimeSeriesPanel",
              "spec": {
                "visualization": {
                  "timePreference": "global_time"
                },
                "formatting": {
                  "unit": "percent",
                  "decimalPrecision": "2"
                },
                "legend": {
                  "position": "bottom"
                },
                "chartAppearance": {
                  "lineStyle": "solid",
                  "lineInterpolation": "spline",
                  "fillMode": "none"
                }
              }
            },
            "queries": [
              {
                "kind": "time_series",
                "spec": {
                  "plugin": {
                    "kind": "signoz/CompositeQuery",
                    "spec": {
                      "queries": [
                        {
                          "type": "builder_query",
                          "spec": {
                            "name": "A",
                            "signal": "metrics",
                            "stepInterval": 0,
                            "disabled": true,
                            "filter": {
                              "expression": "service.name = $service_name AND deployment.environment IN $environment AND status.code IN ['STATUS_CODE_ERROR']"
                            },
                            "aggregations": [
                              {
                                "metricName": "signoz_external_call_latency_count",
                                "timeAggregation": "rate",
                                "spaceAggregation": "sum"
                              }
                            ],
                            "groupBy": [
                              {
                                "name": "address",
                                "fieldContext": "attribute",
                                "fieldDataType": "string"
                              }
                            ]
                          }
                        },
                        {
                          "type": "builder_query",
                          "spec": {
                            "name": "B",
                            "signal": "metrics",
                            "stepInterval": 0,
                            "disabled": true,
                            "filter": {
                              "expression": "service.name = $service_name AND deployment.environment IN $environment"
                            },
                            "aggregations": [
                              {
                                "metricName": "signoz_external_call_latency_count",
                                "timeAggregation": "rate",
                                "spaceAggregation": "sum"
                              }
                            ],
                            "groupBy": [
                              {
                                "name": "address",
                                "fieldContext": "attribute",
                                "fieldDataType": "string"
                              }
                            ]
                          }
                        },
                        {
                          "type": "builder_formula",
                          "spec": {
                            "name": "F1",
                            "expression": "A*100/B",
                            "legend": "{{address}}"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "bf19297f-469d-5c7f-87cd-142e51aee195": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "External Call duration"
            },
            "plugin": {
              "kind": "signoz/TimeSeriesPanel",
              "spec": {
                "visualization": {
                  "timePreference": "global_time"
                },
                "formatting": {
                  "unit": "ms",
                  "decimalPrecision": "2"
                },
                "legend": {
                  "position": "bottom"
                },
                "chartAppearance": {
                  "lineStyle": "solid",
                  "lineInterpolation": "spline",
                  "fillMode": "none"
                }
              }
            },
            "queries": [
              {
                "kind": "time_series",
                "spec": {
                  "plugin": {
                    "kind": "signoz/CompositeQuery",
                    "spec": {
                      "queries": [
                        {
                          "type": "builder_query",
                          "spec": {
                            "name": "A",
                            "signal": "metrics",
                            "stepInterval": 0,
                            "disabled": true,
                            "filter": {
                              "expression": "service.name = $service_name AND deployment.environment IN $environment"
                            },
                            "aggregations": [
                              {
                                "metricName": "signoz_external_call_latency_sum",
                                "timeAggregation": "rate",
                                "spaceAggregation": "sum"
                              }
                            ]
                          }
                        },
                        {
                          "type": "builder_query",
                          "spec": {
                            "name": "B",
                            "signal": "metrics",
                            "stepInterval": 0,
                            "disabled": true,
                            "filter": {
                              "expression": "service.name = $service_name AND deployment.environment IN $environment"
                            },
                            "aggregations": [
                              {
                                "metricName": "signoz_external_call_latency_count",
                                "timeAggregation": "rate",
                                "spaceAggregation": "sum"
                              }
                            ]
                          }
                        },
                        {
                          "type": "builder_formula",
                          "spec": {
                            "name": "F1",
                            "expression": "A/B",
                            "legend": "Average Duration"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "6341ce52-d7d7-58a8-9e33-27a3f46bc125": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "External Call RPS(by Address)"
            },
            "plugin": {
              "kind": "signoz/TimeSeriesPanel",
              "spec": {
                "visualization": {
                  "timePreference": "global_time"
                },
                "formatting": {
                  "unit": "reqps",
                  "decimalPrecision": "2"
                },
                "legend": {
                  "position": "bottom"
                },
                "chartAppearance": {
                  "lineStyle": "solid",
                  "lineInterpolation": "spline",
                  "fillMode": "none"
                }
              }
            },
            "queries": [
              {
                "kind": "time_series",
                "spec": {
                  "plugin": {
                    "kind": "signoz/CompositeQuery",
                    "spec": {
                      "queries": [
                        {
                          "type": "builder_query",
                          "spec": {
                            "name": "A",
                            "signal": "metrics",
                            "stepInterval": 0,
                            "disabled": false,
                            "filter": {
                              "expression": "service.name = $service_name AND deployment.environment IN $environment"
                            },
                            "aggregations": [
                              {
                                "metricName": "signoz_external_call_latency_count",
                                "timeAggregation": "rate",
                                "spaceAggregation": "sum"
                              }
                            ],
                            "groupBy": [
                              {
                                "name": "address",
                                "fieldContext": "attribute",
                                "fieldDataType": "string"
                              }
                            ],
                            "legend": "{{address}}"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "ad2de3fd-cd9f-5406-8e48-6d3811a31c14": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "External Call duration(by Address)"
            },
            "plugin": {
              "kind": "signoz/TimeSeriesPanel",
              "spec": {
                "visualization": {
                  "timePreference": "global_time"
                },
                "formatting": {
                  "unit": "ms",
                  "decimalPrecision": "2"
                },
                "legend": {
                  "position": "bottom"
                },
                "chartAppearance": {
                  "lineStyle": "solid",
                  "lineInterpolation": "spline",
                  "fillMode": "none"
                }
              }
            },
            "queries": [
              {
                "kind": "time_series",
                "spec": {
                  "plugin": {
                    "kind": "signoz/CompositeQuery",
                    "spec": {
                      "queries": [
                        {
                          "type": "builder_query",
                          "spec": {
                            "name": "A",
                            "signal": "metrics",
                            "stepInterval": 0,
                            "disabled": true,
                            "filter": {
                              "expression": "service.name = $service_name AND deployment.environment IN $environment"
                            },
                            "aggregations": [
                              {
                                "metricName": "signoz_external_call_latency_sum",
                                "timeAggregation": "rate",
                                "spaceAggregation": "sum"
                              }
                            ],
                            "groupBy": [
                              {
                                "name": "address",
                                "fieldContext": "attribute",
                                "fieldDataType": "string"
                              }
                            ]
                          }
                        },
                        {
                          "type": "builder_query",
                          "spec": {
                            "name": "B",
                            "signal": "metrics",
                            "stepInterval": 0,
                            "disabled": true,
                            "filter": {
                              "expression": "service.name = $service_name AND deployment.environment IN $environment"
                            },
                            "aggregations": [
                              {
                                "metricName": "signoz_external_call_latency_count",
                                "timeAggregation": "rate",
                                "spaceAggregation": "sum"
                              }
                            ],
                            "groupBy": [
                              {
                                "name": "address",
                                "fieldContext": "attribute",
                                "fieldDataType": "string"
                              }
                            ]
                          }
                        },
                        {
                          "type": "builder_formula",
                          "spec": {
                            "name": "F1",
                            "expression": "A/B",
                            "legend": "{{address}}"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
