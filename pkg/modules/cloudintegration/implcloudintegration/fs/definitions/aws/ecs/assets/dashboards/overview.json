                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "aws_ECS_MemoryUtilization_min",
                        "temporality": "",
                        "timeAggregation": "min",
                        "spaceAggregation": "min",
                        "reduceTo": "avg"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "(cloud.region = $Region AND cloud.account.id = $Account AND ClusterName IN $Cluster)"
                    },
                    "groupBy": [
                      {
                        "name": "ServiceName",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "ClusterName",
