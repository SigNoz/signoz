FROM node:22-bookworm AS build

WORKDIR /opt/

# Build steps run as root; docker derives HOME from the build user rather
# than declaring it in the image config. Declare it explicitly.
ENV HOME=/root
# pnpm's store defaults to $PNPM_HOME/store; pin PNPM_HOME so the cache-mount
# targets below always match where pnpm actually reads and writes (same idea
# as GOCACHE in the go stage). Deliberately a dedicated directory outside
# $HOME: pnpm manages everything inside PNPM_HOME.
ENV PNPM_HOME=/pnpm
ENV NODE_OPTIONS=--max-old-space-size=8192

RUN CI=1 npm i -g pnpm@10

# Dependencies are fetched from the lockfile alone, before the source copy,
# so source edits don't invalidate this layer. pnpm fetch runs no lifecycle
# scripts, which is what allows it to work without the source present (the
# repo's postinstall needs source files). The store cache mount keeps
# downloaded packages across builds for when the lockfile does change.
COPY ./frontend/package.json ./frontend/pnpm-lock.yaml ./frontend/pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/pnpm/store CI=1 pnpm fetch

COPY ./frontend/ ./
# Offline: everything was downloaded by pnpm fetch above, so this only links
# node_modules from the store and runs postinstall. CI=1 implies
# --frozen-lockfile, so a lockfile/manifest mismatch fails loudly.
RUN --mount=type=cache,target=/pnpm/store CI=1 pnpm install --offline
RUN CI=1 pnpm build

FROM golang:1.25-bookworm

ARG OS="linux"
ARG TARGETARCH
ARG ZEUSURL

# Build steps run as root; docker derives HOME from the build user rather
# than declaring it in the image config. Declare it explicitly — every /root
# in this stage derives from it.
ENV HOME=/root

# This path is important for stacktraces
WORKDIR $GOPATH/src/github.com/signoz/signoz
WORKDIR $HOME

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		g++ \
		gcc \
		libc6-dev \
		pkg-config \
	; \
	rm -rf /var/lib/apt/lists/*

# Go writes its build cache to GOCACHE ($HOME-derived) and its module cache
# to GOMODCACHE ($GOPATH-derived). Pin both explicitly so the cache-mount
# targets below always match where go actually reads and writes; keep the
# literal mount targets in sync with these.
ENV GOCACHE=$HOME/.cache/go-build
ENV GOMODCACHE=$GOPATH/pkg/mod

COPY go.mod go.sum ./

# Cache mounts (BuildKit) keep the module and build caches alive across
# builds, so a source change only recompiles the affected packages instead
# of the whole tree. The cache ids (defaulting to the target path) are shared
# with Dockerfile.integration.
RUN --mount=type=cache,target=/go/pkg/mod \
	go mod download

COPY ./cmd/ ./cmd/
COPY ./ee/ ./ee/
COPY ./pkg/ ./pkg/
COPY ./templates /root/templates

# The build command is embedded (instead of COPY Makefile + make
# go-build-enterprise-race) so Makefile changes don't invalidate this layer.
# The Makefile's git-derived ldflags (version, hash, branch, time) resolve to
# empty in here anyway: .git is dockerignored.
RUN --mount=type=cache,target=/go/pkg/mod \
	--mount=type=cache,target=/root/.cache/go-build \
	GOARCH=${TARGETARCH} GOOS=${OS} go build -C ./cmd/enterprise -race -tags timetzdata -o /root/signoz \
	-ldflags "-s -w \
		-X github.com/SigNoz/signoz/pkg/version.version=integration \
		-X github.com/SigNoz/signoz/pkg/version.variant=enterprise \
		-X github.com/SigNoz/signoz/ee/zeus.url=${ZEUSURL} \
		-X github.com/SigNoz/signoz/ee/zeus.deprecatedURL=${ZEUSURL}/api/v1"

COPY --from=build /opt/build ./web/

RUN chmod 755 /root /root/signoz

ENTRYPOINT ["/root/signoz", "server"]
