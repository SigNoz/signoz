FROM golang:1.25-bookworm

ARG OS="linux"
ARG TARGETARCH
ARG ZEUSURL

# Build steps run as root; docker derives HOME from the build user rather
# than declaring it in the image config. Declare it explicitly — every /root
# in this file derives from it.
ENV HOME=/root

# This path is important for stacktraces
WORKDIR $GOPATH/src/github.com/signoz/signoz
WORKDIR $HOME

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		g++ \
		gcc \
		libc6-dev \
		pkg-config \
	; \
	rm -rf /var/lib/apt/lists/*

# Go writes its build cache to GOCACHE ($HOME-derived) and its module cache
# to GOMODCACHE ($GOPATH-derived). Pin both explicitly so the cache-mount
# targets below always match where go actually reads and writes; keep the
# literal mount targets in sync with these.
ENV GOCACHE=$HOME/.cache/go-build
ENV GOMODCACHE=$GOPATH/pkg/mod

COPY go.mod go.sum ./

# Cache mounts (BuildKit) keep the module and build caches alive across
# builds, so a source change only recompiles the affected packages instead
# of the whole tree.
RUN --mount=type=cache,target=/go/pkg/mod \
	go mod download

COPY ./cmd/ ./cmd/
COPY ./ee/ ./ee/
COPY ./pkg/ ./pkg/
COPY ./templates /root/templates

# The build command is embedded (instead of COPY Makefile + make
# go-build-enterprise-race) so Makefile changes don't invalidate this layer.
# The Makefile's git-derived ldflags (version, hash, branch, time) resolve to
# empty in here anyway: .git is dockerignored.
RUN --mount=type=cache,target=/go/pkg/mod \
	--mount=type=cache,target=/root/.cache/go-build \
	GOARCH=${TARGETARCH} GOOS=${OS} go build -C ./cmd/enterprise -race -tags timetzdata -o /root/signoz \
	-ldflags "-s -w \
		-X github.com/SigNoz/signoz/pkg/version.version=integration \
		-X github.com/SigNoz/signoz/pkg/version.variant=enterprise \
		-X github.com/SigNoz/signoz/ee/zeus.url=${ZEUSURL} \
		-X github.com/SigNoz/signoz/ee/zeus.deprecatedURL=${ZEUSURL}/api/v1"

RUN chmod 755 /root /root/signoz

ENTRYPOINT ["/root/signoz", "server"]
